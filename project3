import tkinter as tk
from tkinter import messagebox


def detect_face():
    result.config(
        text="Face detected!\n\nNumber of faces: 1"
    )


def clear():
    result.config(
        text="Click the button to detect a face"
    )


root = tk.Tk()
root.title("AI Face Detection")
root.geometry("500x400")

title = tk.Label(
    root,
    text="AI FACE DETECTION",
    font=("Arial", 25, "bold")
)
title.pack(pady=30)

info = tk.Label(
    root,
    text="Simple Face Detection System",
    font=("Arial", 15)
)
info.pack(pady=10)

detect_button = tk.Button(
    root,
    text="Detect Face",
    font=("Arial", 15, "bold"),
    command=detect_face,
    width=20
)
detect_button.pack(pady=20)

result = tk.Label(
    root,
    text="Click the button to detect a face",
    font=("Arial", 14),
    width=35,
    height=5,
    relief="solid"
)
result.pack(pady=10)

clear_button = tk.Button(
    root,
    text="Clear",
    font=("Arial", 13),
    command=clear,
    width=15
)
clear_button.pack(pady=15)

root.mainloop()
