import tkinter as tk


def send_message():
    user_message = entry.get().lower()

    if user_message == "":
        return

    chat.insert(tk.END, "You: " + user_message + "\n")

    if "hello" in user_message or "hi" in user_message:
        response = "Hello! How can I help you?"

    elif "how are you" in user_message:
        response = "I am fine! How are you?"

    elif "your name" in user_message:
        response = "My name is Simple AI Chatbot."

    elif "who are you" in user_message:
        response = "I am a rule-based chatbot."

    elif "help" in user_message:
        response = "Sure! You can ask me about my name, time, studies, or greetings."

    elif "study" in user_message:
        response = "Keep practicing every day. You will improve!"

    elif "thank" in user_message:
        response = "You're welcome!"

    elif "bye" in user_message:
        response = "Goodbye! Have a nice day."

    else:
        response = "Sorry, I don't understand that."

    chat.insert(tk.END, "Bot: " + response + "\n\n")
    entry.delete(0, tk.END)


def clear_chat():
    chat.delete("1.0", tk.END)


root = tk.Tk()
root.title("Simple AI Chatbot")
root.geometry("600x600")
root.resizable(False, False)

title = tk.Label(
    root,
    text="AI CHATBOT",
    font=("Arial", 25, "bold")
)
title.pack(pady=20)

chat = tk.Text(
    root,
    font=("Arial", 13),
    width=60,
    height=22
)
chat.pack(pady=10)

entry_frame = tk.Frame(root)
entry_frame.pack(pady=10)

entry = tk.Entry(
    entry_frame,
    font=("Arial", 14),
    width=38
)
entry.grid(row=0, column=0, padx=5)

send_button = tk.Button(
    entry_frame,
    text="Send",
    font=("Arial", 13, "bold"),
    command=send_message
)
send_button.grid(row=0, column=1, padx=5)

clear_button = tk.Button(
    root,
    text="Clear Chat",
    font=("Arial", 12, "bold"),
    command=clear_chat
)
clear_button.pack(pady=10)

root.mainloop()
